{
  "name": "ai-first-os",
  "version": "1.2.0",
  "description": "AI-first OS: one board for all your AI agents, with role routing, a builder and auditor loop, and a phone front door.",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "ai-first-os": "./bin/aios.cjs",
    "aios": "./bin/aios.cjs",
    "fleet": "./bin/fleet.cjs"
  },
  "scripts": {
    "start": "node bin/aios.cjs tui",
    "tui": "node bin/aios.cjs tui",
    "desktop": "node bin/aios.cjs desktop",
    "init": "node bin/aios.cjs init",
    "connect": "node bin/aios.cjs connect",
    "share": "node bin/aios.cjs share",
    "voice": "node bin/aios.cjs voice",
    "board": "node bin/aios.cjs board",
    "task": "node bin/aios.cjs task",
    "run": "node bin/aios.cjs run",
    "watch": "node bin/aios.cjs watch",
    "sync": "node bin/aios.cjs sync",
    "doctor": "node bin/aios.cjs doctor",
    "test": "node --test test/template.test.cjs",
    "build:installer": "node scripts/build-installer.cjs"
  }
}
