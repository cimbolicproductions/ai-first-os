{
  "name": "ai-first-os",
  "version": "2.0.0",
  "description": "AI-first OS: unified chat-first control plane for terminal coding agents, cross-model planning/building/auditing, adaptive quota failover, and 1-link sign-in.",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "ai-first-os": "./bin/aios.cjs",
    "aios": "./bin/aios.cjs",
    "fleet": "./bin/fleet.cjs"
  },
  "scripts": {
    "start": "node bin/aios.cjs desktop",
    "desktop": "node bin/aios.cjs desktop",
    "daemon": "node bin/aios.cjs daemon",
    "watch": "node bin/aios.cjs daemon",
    "chat": "node bin/aios.cjs chat",
    "status": "node bin/aios.cjs status",
    "models": "node bin/aios.cjs models",
    "phone": "node bin/aios.cjs phone",
    "doctor": "node bin/aios.cjs doctor",
    "test": "node --no-warnings --test --test-concurrency=1",
    "build:installer": "node scripts/build-installer.cjs"
  }
}
